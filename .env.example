# libre_quant 环境配置模板
# 用法：cp .env.example .env 然后填写。.env 已在 .gitignore，绝不提交。
# Komodo 部署时：不拷 .env，把下面两项作为容器环境变量注入。

# ── 数据库（家服务器中心库）───────────────────────────────────────────────
# 单账号即可（管理员权限）。容器内连法取决于部署网络：
#   本机 PG：postgresql://USER:PASS@127.0.0.1:5432/libre_quant
#   跨机器：走 wireguard/tailscale 或 SSH 隧道，5432 不暴露公网。
DATABASE_URL=postgresql://libre_quant:CHANGE_ME@localhost:5432/libre_quant

# ── Tavily MCP 检索（可选；data/news.py 归因/预警用）─────────────────────
TAVILY_TOKEN=
